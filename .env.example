# Required: Path to your C# codebase root
# Use absolute path for best results
CSHARP_CODEBASE_PATH=/path/to/your/csharp/project

# Optional: GLM API key for AI-assisted exploration
# Get your key from: https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here

# Optional: GLM model to use
# Common options: glm-5.3 (default), glm-5.2, glm-5.1, glm-5.3-flash, glm-4.6
# glm-5.3 always thinks (thinking cannot be disabled), so it needs generous max_tokens.
GLM_MODEL=glm-5.3

# Optional: reasoning effort for glm-5.3 (low | high | max). Default: high.
# Leave empty to omit the parameter (older models).
# GLM_REASONING_EFFORT=high

# Optional: Custom memory path
# Default: .codebase-memory/ in your codebase root
# MEMORY_PATH=.codebase-memory
